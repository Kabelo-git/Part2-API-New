@model List<RaceDay.Web.Models.EnrolmentItem>
@{
    ViewData["Title"] = "My Enrolments";
}

<h2 class="mb-3">My Enrolments</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't enrolled in any events yet. <a asp-controller="Home" asp-action="Index">Browse events</a>.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Event</th><th>Category</th><th>Enrolled on</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                var badge = e.Status == "Confirmed" ? "bg-success"
                : e.Status == "Pending" ? "bg-warning text-dark"
                : "bg-secondary";
                <tr>
                    <td><a asp-action="EventDetails" asp-route-id="@e.EventId">@e.EventName</a></td>
                    <td>@e.CategoryName</td>
                    <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td><span class="badge @badge">@e.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}
