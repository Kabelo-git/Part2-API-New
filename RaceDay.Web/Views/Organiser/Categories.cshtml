@model RaceDay.Web.Models.CategoriesViewModel
@{
    ViewData["Title"] = "Categories";
}

<a asp-action="Events" class="text-decoration-none">&larr; Back to my events</a>
<h2 class="mt-2">Categories: @Model.Event.EventName</h2>
<p class="text-muted">Add age or distance categories participants can choose when they enrol.</p>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Add a category</h5>
        <form asp-action="AddCategory" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="EventId" value="@Model.Event.EventId" />
            <div class="col-md-5">
                <label class="form-label">Category name</label>
                <input name="CategoryName" class="form-control" placeholder="e.g. Under 20, Senior, 10km" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Distance (km)</label>
                <input name="Distance" type="number" step="0.1" min="0" value="0" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Price (R)</label>
                <input name="Price" type="number" step="0.01" min="0" value="0" class="form-control" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Add category</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">No categories yet for this event.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Name</th><th>Distance</th><th>Price</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Categories)
            {
                <tr>
                    <td>@c.CategoryName</td>
                    <td>@c.Distance.ToString("0.##") km</td>
                    <td>R @c.Price.ToString("0.00")</td>
                    <td class="text-end">
                        <form asp-action="DeleteCategory" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this category?');">
                            <input type="hidden" name="categoryId" value="@c.CategoryId" />
                            <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}