@model List<RaceDay.Web.Models.EventItem>
@{
    ViewData["Title"] = "My Events";
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">My Events</h2>
    <a asp-action="CreateEvent" class="btn btn-primary">+ Create event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't created any events yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Type</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.EventName</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy, HH:mm")</td>
                        <td>@e.Location</td>
                        <td>@e.Distance km</td>
                        <td>@textInfo.ToTitleCase(e.EventType)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Categories" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-secondary">Categories</a>
                            <a asp-action="Enrolments" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-secondary">Enrolments</a>
                            <a asp-action="Results" asp-route-eventId="@e.EventId" class="btn btn-sm btn-outline-secondary">Results</a>
                            <a asp-action="EditEvent" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="DeleteEvent" asp-route-id="@e.EventId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}