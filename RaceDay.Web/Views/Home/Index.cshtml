@model RaceDay.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var textInfo = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
}

<h2 class="mb-3">Upcoming events</h2>

<form method="get" asp-action="Index" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Search</label>
            <input name="search" value="@Model.Search" class="form-control" placeholder="Name or location" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Type</label>
            <select name="type" class="form-select">
                <option value="">All</option>
                <option value="run" selected="@(Model.Type == "run")">Run</option>
                <option value="walk" selected="@(Model.Type == "walk")">Walk</option>
                <option value="cycle" selected="@(Model.Type == "cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From</label>
            <input name="dateFrom" type="date" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <input name="dateTo" type="date" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">No upcoming events match your filters.</div>
}
else
{
    <div class="row">
        @foreach (var e in Model.Events)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-primary align-self-start mb-2">@textInfo.ToTitleCase(e.EventType)</span>
                        <h5 class="card-title">@e.EventName</h5>
                        <p class="card-text text-muted mb-1">@e.EventDate.ToString("dd MMM yyyy, HH:mm")</p>
                        <p class="card-text text-muted mb-1">@e.Location</p>
                        <p class="card-text text-muted">@e.Distance.ToString("0.##") km</p>
                        <a asp-controller="Participant" asp-action="EventDetails" asp-route-id="@e.EventId"
                           class="btn btn-primary mt-auto">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}